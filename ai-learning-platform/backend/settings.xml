<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <localRepository>/workspace/.m2/repository</localRepository>
  <proxies>
    <proxy>
      <id>sandbox-proxy</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>127.0.0.1</host>
      <port>18080</port>
    </proxy>
    <proxy>
      <id>sandbox-proxy-https</id>
      <active>true</active>
      <protocol>https</protocol>
      <host>127.0.0.1</host>
      <port>18080</port>
    </proxy>
  </proxies>
</settings>
